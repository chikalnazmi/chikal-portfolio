# =========================================================================
# Supabase Configuration for Chikal Portfolio & Studio CMS
# =========================================================================
# Salin file ini menjadi .env.local untuk penggunaan lokal, atau pasang di
# Vercel Project Settings > Environment Variables untuk produksi.

# 1. Supabase Project URL (Dapatkan dari Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Public Key berawalan ey...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. (Opsional) Supabase Service Role Key (Hanya untuk backend server, jangan ekspos ke publik)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
